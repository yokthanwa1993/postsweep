{
  "manifest_version": 3,
  "name": "PostSweep — ล้างโพสต์ Facebook",
  "version": "1.2.1",
  "description": "กดไอคอนเพื่อเปิดบันทึกกิจกรรมและเริ่มย้ายโพสต์ไปถังขยะทันที มีแถบปรับความเร็ว 5 ระดับและปุ่มหยุด",
  "minimum_chrome_version": "111",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.facebook.com/*"
  ],
  "background": {
    "service_worker": "launcher.js",
    "type": "module"
  },
  "action": {
    "default_title": "เปิดบันทึกกิจกรรมและเริ่มลบโพสต์ทั้งหมดทันที",
    "default_icon": {
      "16": "icons/red-white-16.png",
      "32": "icons/red-white-32.png",
      "48": "icons/red-white-48.png",
      "128": "icons/red-white-128.png"
    }
  },
  "icons": {
    "16": "icons/red-white-16.png",
    "32": "icons/red-white-32.png",
    "48": "icons/red-white-48.png",
    "128": "icons/red-white-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src 'none'"
  },
  "short_name": "PostSweep"
}
