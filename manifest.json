{
  "manifest_version": 3,
  "name": "PostSweep — ล้างโพสต์ Facebook",
  "version": "1.3.1",
  "description": "เลือกทั้งหมด วันที่ เดือน หรือช่วงวันที่จากปฏิทินก่อนเริ่มลบ แสดงวันที่ของโพสต์และปรับความเร็วได้ 5 ระดับ",
  "options_page": "start.html",
  "minimum_chrome_version": "111",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.facebook.com/*"
  ],
  "background": {
    "service_worker": "launcher.js",
    "type": "module"
  },
  "action": {
    "default_title": "เลือกช่วงเวลาแล้วเริ่มลบโพสต์",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/red-white-16.png",
      "32": "icons/red-white-32.png",
      "48": "icons/red-white-48.png",
      "128": "icons/red-white-128.png"
    }
  },
  "icons": {
    "16": "icons/red-white-16.png",
    "32": "icons/red-white-32.png",
    "48": "icons/red-white-48.png",
    "128": "icons/red-white-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src 'none'"
  },
  "short_name": "PostSweep"
}
